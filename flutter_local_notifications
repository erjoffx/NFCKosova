Future<void> scheduleDailyNotifications(FlutterLocalNotificationsPlugin plugin) async {
  const androidDetails = AndroidNotificationDetails(
    'termin_channel',
    'Njoftime Terminesh',
    importance: Importance.max,
    priority: Priority.high,
  );

  // Njoftimi i orës 12:00
  await plugin.zonedSchedule(
    0,
    'Kujtesë Terminesh - NFCKosova',
    'Kontrolloni takimet e pasditës me bizneset!',
    _nextInstanceOfTime(12, 0),
    const NotificationDetails(android: androidDetails),
    androidScheduleMode: AndroidScheduleMode.exactAllowWhileIdle,
    uiLocalNotificationDateInterpretation: UILocalNotificationDateInterpretation.absoluteTime,
    matchDateTimeComponents: DateTimeComponents.time,
  );

  // Njoftimi i orës 18:00
  await plugin.zonedSchedule(
    1,
    'Përmbledhje Terminesh - NFCKosova',
    'Rishikoni takimet e përfunduara dhe ato të nesërmet!',
    _nextInstanceOfTime(18, 0),
    const NotificationDetails(android: androidDetails),
    androidScheduleMode: AndroidScheduleMode.exactAllowWhileIdle,
    uiLocalNotificationDateInterpretation: UILocalNotificationDateInterpretation.absoluteTime,
    matchDateTimeComponents: DateTimeComponents.time,
  );
}
